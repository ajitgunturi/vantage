# vantage — machine-local make environment (.env)
#
# Copy this file to .env and fill in the values:
#
#   cp .env.example .env
#
# .env is gitignored; the Makefile auto-creates an empty template on first run
# and `include`s it at parse time. Only the two variables below are consumed
# (and exported) by the Makefile — Docker-dependent targets (test, coverage,
# e2e, docker, deploy, soak, ...) hard-fail via `make check-env` if DOCKER_HOST
# is empty. Pure-Go targets (build, lint, proto, swagger) never need them.

# Docker socket for your container runtime (REQUIRED for Docker targets).
#   Rancher Desktop: DOCKER_HOST=unix:///Users/<you>/.rd/docker.sock
#   Docker Desktop:  DOCKER_HOST=unix:///Users/<you>/.docker/run/docker.sock
#   Linux (default): DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_HOST=

# Disable the testcontainers Ryuk reaper container. Required on runtimes where
# Ryuk cannot mount the Docker socket (e.g. Rancher Desktop); containers are
# cleaned up by test teardown instead.
TESTCONTAINERS_RYUK_DISABLED=true

# ─── Reference: service runtime configuration ────────────────────────────────
# The variables below are NOT read from this file. They are documented here for
# reference when running service binaries directly (set them in your shell).
# docker-compose*.yml and deployments/ (Helm values) set them for containers.
#
# MQ (cmd/mq)
#   MQ_GRPC_ADDR=:50051            # gRPC listener (Produce/Consume)
#   MQ_HTTP_ADDR=:8080             # HTTP control plane (/api/v1/queue/inspect)
#   MQ_BUFFER_SIZE=10000           # in-memory ring buffer capacity
#   MQ_CONSUME_CREDIT=20           # default per-consumer in-flight window
#
# Streamer (cmd/streamer)
#   STREAMER_MQ_ADDR=:50051        # MQ gRPC address
#   STREAMER_CSV_PATH=             # REQUIRED — path to the DCGM metrics CSV
#   STREAMER_LOOP_DELAY_MS=1       # inter-row publish delay (0 disables)
#
# Collector (cmd/collector)
#   COLLECTOR_MQ_ADDR=:50051       # MQ gRPC address
#   COLLECTOR_BATCH_SIZE=50        # size-triggered flush threshold
#   COLLECTOR_FLUSH_MS=500         # time-triggered flush interval
#   COLLECTOR_CREDIT=100           # initial credit window (>= BATCH_SIZE)
#
# Database (pkg/db — Collector + Gateway)
#   VANTAGE_DB_DSN=                # REQUIRED — postgres://user:pass@host:5432/db?sslmode=disable
#                                  # contains credentials: never commit or log
#   VANTAGE_DB_MAX_CONNS=          # optional pgxpool cap (default: max(4, NumCPU))
#
# API Gateway (cmd/gateway)
#   GATEWAY_ADDR=:8080             # HTTP listen address
#   VANTAGE_GATEWAY_MAX_ROWS=1000  # telemetry endpoint row ceiling
#
# ─── Reference: make target knobs (pass on the command line) ─────────────────
#   make soak SOAK_DURATION=60 SOAK_STREAMERS=3   # soak length / streamer scale
#   make smoke-05 LOCAL_PORT=8081                 # gateway port-forward port
